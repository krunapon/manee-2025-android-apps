<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Search Field -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:hint="ค้นหาคำศัพท์">

        <EditText
            android:id="@+id/etSearchWord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:maxLines="1"
            android:inputType="text" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Word Title -->
    <TextView
        android:id="@+id/tvWordTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="คำศัพท์ภาษามือ"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- Video View -->
    <VideoView
        android:id="@+id/videoView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginBottom="16dp"
        android:background="#f0f0f0" />

    <!-- Word Meaning -->
    <TextView
        android:id="@+id/tvWordMeaning"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="ความหมายจะแสดงที่นี่"
        android:textSize="16sp"
        android:padding="12dp"
        android:background="@drawable/rounded_background"
        android:layout_marginBottom="16dp"
        android:gravity="center" />

    <!-- Button Container -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <!-- Replay Button (เปลี่ยนจาก แปล เป็น เล่นซ้ำ) -->
        <Button
            android:id="@+id/btnTranslate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="เล่นซ้ำ"
            android:textSize="16sp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@color/button_primary_color" />

        <!-- Video Replay Button -->
        <Button
            android:id="@+id/btnReplay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="เล่นวิดีโอซ้ำ"
            android:textSize="16sp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/warning_orange" />

    </LinearLayout>

    <!-- Navigation Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Back Button -->
        <Button
            android:id="@+id/btnBack"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="กลับ"
            android:textSize="16sp"
            android:layout_marginEnd="8dp"
            android:backgroundTint="@color/text_secondary" />

        <!-- Other Word Button -->
        <Button
            android:id="@+id/btnOtherWord"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="คำถัดไป"
            android:textSize="16sp"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/button_primary_color" />

    </LinearLayout>

</LinearLayout>