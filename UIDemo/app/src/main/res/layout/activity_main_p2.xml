<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:background="#F8FAFC"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <TextView
        android:text="TSL App"
        android:id="@+id/tvTitle"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#1A6BBF"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <TextView
        android:text="ระบบแปลภาษามือไทย"
        android:layout_centerHorizontal="true"
        android:id="@+id/Subtitle"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#74C365"
        android:layout_marginTop="50dp"
        android:layout_below="@+id/tvTitle"
        android:layout_alignParentTop="true"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

    <LinearLayout android:id="@+id/videoContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/Subtitle"
        android:layout_above="@id/buttonLayout"
        android:layout_centerHorizontal="true"
        android:gravity="center"
        >
        <VideoView
            android:id="@+id/videoView"
            android:layout_width="300dp"
            android:layout_height="300dp"/>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/buttonLayout"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_alignParentBottom="true"
        android:gravity="center">

        <Button
            android:text="เรียนรู้"
            android:id="@+id/btnLearn"
            android:textColor="#FFFFFF"
            android:textSize="26sp"
            android:backgroundTint="#74C365"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <Button
            android:text="เริ่มต้น"
            android:id="@+id/btnStart"
            android:textSize="26sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1A6BBF"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

</RelativeLayout>
